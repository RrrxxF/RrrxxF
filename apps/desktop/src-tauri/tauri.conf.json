{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesignWorkbench",
  "version": "0.2.0",
  "identifier": "com.rrrxxf.designworkbench",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DesignWorkbench",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
